            return 0 ;;
    esac
    return 1
}

# Category helpers: print every command in one category, in order.
# Category names are distinct from command names (editing != edit) so
# `help edit` and `help editing` resolve unambiguously.
show_help_category() {
    local cat label color cmds=()
    case "$1" in
        logging)
            label="LOGGING"; color="$GREEN"
            cmds=("log" "resume") ;;
        view|viewing)
            label="VIEW"; color="$CYAN"
            cmds=("all" "ls" "stats" "grep") ;;
        editing|edits)
            label="EDIT"; color="$YELLOW"
            cmds=("edit" "title" "desc" "type" "start" "end" "bill" "rm") ;;
        scoping|scopes)
            label="SCOPE"; color="$MAGENTA"
            cmds=("today" "yesterday" "tomorrow" "goto" "month" "year" "range" "cal" "scope") ;;
        tools|tooling)
            label="TOOLS"; color="$BLUE"
            cmds=("status" "export" "profile" "migrate" "clear" "help" "quit") ;;
        *) return 1 ;;
    esac
    echo -e "  ${BOLD}${color}${label}${NC}"
    echo
    local c
    for c in "${cmds[@]}"; do
        show_help_command "$c"
    done
    return 0
}

# `help [target]` dispatcher.
# Lookup order: full -> command -> category -> topic.
show_help_dispatch() {
    local target="$1"
    if [ -z "$target" ]; then
        show_help; return
    fi
    case "$target" in
        full|verbose) show_full_help; return ;;
    esac
    echo
    if show_help_command "$target"; then
        echo; return
    fi
    if show_help_category "$target"; then
        echo; return
    fi
    if show_help_topic "$target"; then
        echo; return
    fi
    echo -e "  ${YELLOW}no help for '${target}'${NC}"
    echo
    help_hint
    echo
}

