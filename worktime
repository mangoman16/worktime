help_hint() {
    echo -e "  ${BOLD}drill in${NC}"
    echo -e "    ${WHITE}help <category>${NC}   ${GREEN}logging${NC}${DIM},${NC} ${CYAN}view${NC}${DIM},${NC} ${YELLOW}editing${NC}${DIM},${NC} ${MAGENTA}scoping${NC}${DIM},${NC} ${BLUE}tools${NC}"
