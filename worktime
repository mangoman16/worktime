# ============================================================
#  Contextual main prompt
# ============================================================
# =====================================================================
# Prompt — multi-depth tree
# =====================================================================
#
# Idle:
#   .
#   ├── 10:57 [50m]
#   └──
#
# Mid-task description prompt:
#   .
#   ├── 10:57 [50m]
#   │   └── [ticket] #999 fix login
#   │       └── desc >
#
# Inline single-field edit (eg. `title 5`):
#   .
#   ├── 10:57 [50m]
#   │   └── [ticket] #999 fix login
#   │       └── title [#999 fix login] >
#
# Full edit walkthrough (eg. `edit 5`):
#   .
#   ├── 10:57 [50m]
#   │   └── [ticket] #999 fix login
#   │       ├── title [#999 fix login] >
#   │       ├── start [10:00] >
#   │       ├── end   [11:00] >
#   │       ├── type  [ticket] >
#   │       ├── desc  [old desc] >
#   │       └── bill  [0.00] >
#
# In-break flow uses the same shape with the bracket coloured green
# and showing the actual break countdown:
#   .
#   ├── 10:57 [break 09:30]
#   └── ↵ to skip

# Generic progress bar - used by handle_break_flow.
progress_bar() {
    local w="$1" e="$2" t="$3"
    local filled=0
    [ "$t" -gt 0 ] && filled=$((e * w / t))
    [ "$filled" -gt "$w" ] && filled="$w"
    [ "$filled" -lt 0 ] && filled=0
    local empty=$((w - filled))
    local out="" i
    for ((i=0; i<filled; i++)); do out+="━"; done
    for ((i=0; i<empty;  i++)); do out+="╶"; done
    printf "%s" "$out"
}

# Work-block countdown bracket: '[50m]' / '[+5m]'.
# Color: white normally, red once overdue. Empty when no block.
fmt_break_bracket() {
    [[ "${BREAKS_ENABLED,,}" =~ ^(yes|true|y|1|on)$ ]] || return 0
    [ "$BLOCK_START_TS" -gt 0 ] || return 0
    local now; now=$(date +%s)
    local remain=$((BREAK_NEXT_AT_TS - now))
    local color="$WHITE"
    [ "$remain" -le 0 ] && color="$RED"
    local txt
    if [ "$remain" -ge 60 ]; then
        txt="$((remain / 60))m"
    elif [ "$remain" -gt 0 ]; then
        txt="1m"
    elif [ "$remain" -eq 0 ]; then
        txt="BREAK"
    else
        local over=$((-remain))
        if [ "$over" -ge 60 ]; then
            txt="+$((over / 60))m"
        else
            txt="+1m"
        fi
    fi
    printf "%s[%s%s%s]%s" "$DIM" "$color" "$txt" "$DIM" "$NC"
}

# Scope bracket, e.g. '[yesterday]'. Empty when scope is plain today.
fmt_scope_bracket() {
    local active="${ACTIVE_DATE:-$(today_date)}"
    local today; today=$(today_date)
    if [ -z "${ACTIVE_DATE:-}" ]; then
        printf "%s[%s%s%s]%s" "$DIM" "$MAGENTA" "$SCOPE_LABEL" "$DIM" "$NC"
    elif [ "$active" != "$today" ]; then
        local short="$active"
        if [ "$active" = "$(date -d '1 day ago' +%Y-%m-%d 2>/dev/null)" ]; then
            short="yesterday"
        elif [ "$active" = "$(date -d 'tomorrow' +%Y-%m-%d 2>/dev/null)" ]; then
            short="tomorrow"
        fi
        printf "%s[%s%s%s]%s" "$DIM" "$YELLOW" "$short" "$DIM" "$NC"
    fi
}

# Just the time-line, no root '.' prefix. Used by handle_break_flow's
# in-place redraw (it preserves the root and only repaints this).
fmt_tree_top_line() {
    local override_break="${1-}"
    local time_str; time_str=$(date +%H:%M)
    local scope_b; scope_b=$(fmt_scope_bracket)
    local break_b
    if [ -n "$override_break" ]; then
        break_b="$override_break"
    else
        break_b=$(fmt_break_bracket)
    fi
    local out="${DIM}├──${NC} ${DIM}${time_str}${NC}"
    [ -n "$scope_b" ] && out+=" $scope_b"
    [ -n "$break_b" ] && out+=" $break_b"
    printf "%s" "$out"
}

# Root '.' + time-line, joined by a real newline.
fmt_tree_top() {
    local line; line=$(fmt_tree_top_line "$@")
    printf "%s.%s\n%s" "$DIM" "$NC" "$line"
}

# Idle main prompt:
#   .
#   ├── 10:57 [50m]
#   └──
fmt_simple_prompt() {
    local top; top=$(fmt_tree_top)
    printf "%s\n%s└──%s " "$top" "$DIM" "$NC"
}

# Description prompt — used while a task is in-progress and we're
# asking the user for the description. Shape:
#   .
#   ├── 10:57 [50m]
#   │   └── [type] title
#   │       └── desc >
fmt_desc_prompt() {
    local type="$1" title="$2"
    local tc; tc=$(type_color "$type")
    local top; top=$(fmt_tree_top)
    local task_line="${DIM}│   └──${NC} ${tc}[${type}]${NC}"
    [ -n "$title" ] && task_line+=" ${WHITE}${title}${NC}"
    printf "%s\n%s\n%s│       └──%s ${DIM}desc${NC} %s>%s " \
        "$top" "$task_line" "$DIM" "$NC" "$BOLD" "$NC"
}

# Print the tree header to stdout (root + time-line + task-line),
# WITH trailing newline. Use this once before a sequence of
# sub-prompts (eg. edit_task_full's six fields) to draw the
# fixed part of the tree.
print_tree_header() {
    local type="$1" task_title="$2"
    local tc; tc=$(type_color "${type:-task}")
    local top; top=$(fmt_tree_top)
    local task_line="${DIM}│   └──${NC} ${tc}[${type}]${NC}"
    [ -n "$task_title" ] && task_line+=" ${WHITE}${task_title}${NC}"
    printf "%s\n%s\n" "$top" "$task_line"
}

# Format a single field-prompt line (no trailing newline).
#   │       ├── title [current] >    (when is_last=0)
#   │       └── title [current] >    (when is_last=1)
fmt_field_line() {
    local field="$1" current="$2" is_last="${3:-1}"
    local connector="├──"
    [ "$is_last" = "1" ] && connector="└──"
    local line="${DIM}│       ${connector}${NC} ${DIM}${field}${NC}"
    [ -n "$current" ] && line+=" ${WHITE}[${current}]${NC}"
    line+=" ${BOLD}>${NC} "
    printf "%s" "$line"
}

# Edit label for sub-prompts that don't yet have a task title in
# context (eg. log_new_task asking for the very first title). Keeps
# the old single-line '[type] [current] >' format for callers that
# can't supply a task title yet.
fmt_edit_label() {
    local type="${1:-task}" current="${2-}"
    local tc; tc=$(type_color "$type")
    local out; out=$(printf "%s[%s]%s" "$tc" "$type" "$NC")
    [ -n "$current" ] && out+=$(printf " %s%s%s" "$WHITE" "$current" "$NC")
    out+=$(printf " %s>%s " "$BOLD" "$NC")
    printf "%s" "$out"
}

# Detailed break/cycle snapshot for the `status` command.
show_break_status() {
    if ! [[ "${BREAKS_ENABLED,,}" =~ ^(yes|true|y|1|on)$ ]]; then
        echo
        echo -e "  ${DIM}Bildschirmpause:${NC} ${YELLOW}disabled${NC}"
        echo
        return
    fi
    echo
    echo -e "  ${BOLD}Bildschirmpause status${NC}"
    if [ "$BLOCK_START_TS" -le 0 ]; then
        printf "  ${DIM}%-13s${NC}  ${WHITE}%s${NC}\n" "block"      "(none — start a task to begin a cycle)"
        echo
        return
    fi
    local now; now=$(date +%s)
    local worked=$((now - BLOCK_START_TS))
    local block_start; block_start=$(date -d "@$BLOCK_START_TS" +%H:%M)
    local block_min=$((BREAK_WORK_BLOCK / 60))
    local req_min=$((BREAK_NEXT_DURATION_SEC / 60))
    local until_break=$((BREAK_NEXT_AT_TS - now))
    local next_at; next_at=$(date -d "@$BREAK_NEXT_AT_TS" +%H:%M)
    local last_end_str="(none yet)"
    [ "$LAST_END_TS" -gt 0 ] && last_end_str=$(date -d "@$LAST_END_TS" +%H:%M)
    local skipped_n=${#BREAK_SKIPPED[@]}

    printf "  ${DIM}%-13s${NC}  ${WHITE}started %s — worked %dm of %dm${NC}\n" \
        "block" "$block_start" "$((worked/60))" "$block_min"
    printf "  ${DIM}%-13s${NC}  ${WHITE}%s${NC}\n" \
        "last task end" "$last_end_str"
    if [ "$until_break" -gt 0 ]; then
        local rem_min=$((until_break / 60))
        printf "  ${DIM}%-13s${NC}  ${WHITE}%s${NC} ${DIM}(in %dm, %d min long)${NC}\n" \
            "next break" "$next_at" "$rem_min" "$req_min"
    else
        local over=$(( -until_break / 60 ))
        printf "  ${DIM}%-13s${NC}  ${RED}OVERDUE${NC} ${DIM}by %dm (was scheduled %s)${NC}\n" \
            "next break" "$over" "$next_at"
    fi
    if [ "$skipped_n" -gt 0 ]; then
        printf "  ${DIM}%-13s${NC}  ${YELLOW}%d on record${NC}\n" "skipped" "$skipped_n"
        local s
        for s in "${BREAK_SKIPPED[@]}"; do
            echo -e "    ${DIM}skipped ${s}${NC}"
        done
    fi
    echo
}

# ============================================================
#  CLI flag parsing
# ============================================================
INITIAL_DIR=""
INITIAL_LOG=""

usage_cli() {
    echo "Usage: $(basename "$0") [options]"
    echo "  -d, --directory <dir>   recursively scope to a directory"
    echo "  -l, --log <file>        scope to a single log file"
    echo "  -h, --help              show this help and exit"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--directory)
            if [ $# -lt 2 ]; then echo "missing argument for $1" >&2; exit 1; fi
            INITIAL_DIR="$2"
            shift 2
            ;;
        -l|--log)
            if [ $# -lt 2 ]; then echo "missing argument for $1" >&2; exit 1; fi
            INITIAL_LOG="$2"
            shift 2
            ;;
        -h|--help)
            usage_cli
            exit 0
            ;;
        *)
            echo "unknown option: $1" >&2
            usage_cli
            exit 1
            ;;
    esac
done

# ============================================================
#  Main
# ============================================================
clear
migrate_legacy

if [ ! -f "$PROFILE_FILE" ]; then
    echo -e "  ${BOLD}task-timer${NC} ${DIM}${VERSION}${NC}"
    echo
    echo -e "  ${YELLOW}no profile found${NC}  ${DIM}let's set one up${NC}"
    interactive_profile_setup
    echo
    echo -e "  ${DIM}entering timer...${NC}"
    sleep 1
    clear
fi

load_profile

# Apply CLI-driven scope, falling back to today.
if [ -n "$INITIAL_LOG" ]; then
    if ! scope_set_logfile "$INITIAL_LOG"; then exit 1; fi
elif [ -n "$INITIAL_DIR" ]; then
    if ! scope_set_directory "$INITIAL_DIR"; then exit 1; fi
else
    scope_set_today
fi

touch_timestamp
start_break_watcher
show_calendar "" minimal
show_welcome

while true; do
    break_check_gap_reset
    if [ -f "$ALERT_FILE" ]; then
        rm -f "$ALERT_FILE"
        handle_break_alert
        continue
    fi

    if ! IFS= read -r -p "$(fmt_simple_prompt)" input; then
        echo
        break
    fi

    input=$(trim_ws "$input")
    cmd="${input%% *}"
    args="${input#"$cmd"}"
    args="${args# }"

    case "$cmd" in
        "" )
            touch_timestamp; continue ;;
        quit|exit|q )
            break ;;
        * )
            if ! dispatch_command "$cmd" "$args"; then
                log_new_task "$input"
                echo
            fi
            ;;
    esac
    touch_timestamp
done
