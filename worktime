# Render one category row: colored label + comma-separated command names.
print_help_row() {
    local label="$1" color="$2"; shift 2
    local sep="${DIM},${NC} "
    local line="" cmd first=1
    for cmd in "$@"; do
        if [ $first -eq 1 ]; then
            line="${DIM}${cmd}${NC}"; first=0
        else
            line+="${sep}${DIM}${cmd}${NC}"
        fi
    done
    printf "  ${color}%-7s${NC}   %b\n" "$label" "$line"
}

show_help() {
    echo
    echo -e "  ${BOLD}task-timer${NC} ${DIM}commands${NC}"
    echo
    print_help_row "LOGGING" "$GREEN"   "<title>" "<type> <title>" "resume"
    print_help_row "VIEW"    "$CYAN"    "all" "ls" "stats" "grep"
    print_help_row "EDIT"    "$YELLOW"  "edit" "title" "desc" "type" "start" "end" "bill" "rm"
    print_help_row "SCOPE"   "$MAGENTA" "today" "yesterday" "tomorrow" "goto" "month" "year" "range" "cal" "scope"
    print_help_row "TOOLS"   "$BLUE"    "status" "export" "profile" "migrate" "clear" "help" "quit"
    echo
    help_hint
    echo
}

# Per-command details. Returns 1 if the name is unknown.
