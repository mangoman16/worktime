            printf "    ${GREEN}%-26s${NC}${DIM}-> %s${NC}\n"  "NNNNNNNN"                  "order        (8+ standalone digits)"
            printf "    ${BLUE}%-26s${NC}${DIM}-> %s${NC}\n"   "termin / appointment"      "appointment  (word in the title)"
            printf "    ${TEAL}%-26s${NC}${DIM}-> %s${NC}\n"   "tel / telefon / telephone" "call"
            return 0 ;;
        billing|bill-topic)
            local rate_note=""
