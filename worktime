        cal|calendar) echo -e "  ${BOLD}cal${NC}   [YYYY-MM]              calendar grid with activity markers" ;;
        scope)
            echo -e "  ${BOLD}scope${NC}                        print current scope info and files"
            echo -e "    ${WHITE}scope <verb> [args]${NC}         nested form"
            echo -e "      ${WHITE}show${NC}                       same as bare 'scope'"
            echo -e "      ${WHITE}today${NC}                      reset to today"
            echo -e "      ${WHITE}yesterday${NC} | ${WHITE}tomorrow${NC}      shift the active date"
            echo -e "      ${WHITE}goto YYYY-MM-DD${NC}            jump to a specific date"
            echo -e "      ${WHITE}month [YYYY-MM]${NC}            scope a whole month"
            echo -e "      ${WHITE}year  [YYYY]${NC}               scope a whole year"
            echo -e "      ${WHITE}range S E${NC}                  scope an arbitrary range"
            echo -e "    ${DIM}flat shortcuts (today / yesterday / month / ...) still work.${NC}"
            ;;

        # ---- TOOLS ----
        status)
            echo -e "  ${BOLD}status${NC}                       Bildschirmpause snapshot"
            echo -e "    ${DIM}block start, time worked, time until next break, skip history${NC}"
            ;;
        export)
            echo -e "  ${BOLD}export${NC}                       write ICS file for the active scope"
            ;;
        profile|config)
            echo -e "  ${BOLD}profile${NC}                      show profile values"
            echo -e "    ${WHITE}profile show${NC}               same as bare 'profile'"
            echo -e "    ${WHITE}profile edit${NC}               walk through profile fields"
            echo -e "    ${WHITE}profile open${NC}               open the profile file in \$EDITOR"
            ;;
        migrate)
            echo -e "  ${BOLD}migrate${NC}                      move legacy logs into the year/month tree"
            ;;
        clear)
            echo -e "  ${BOLD}clear${NC}                        clear the screen"
            ;;
        help|"?")
            echo -e "  ${BOLD}help${NC}                         compact command summary"
            echo -e "    ${WHITE}help <category>${NC}            logging  view  editing  scoping  tools"
            echo -e "    ${WHITE}help <command>${NC}             details for one command"
            echo -e "    ${WHITE}help <topic>${NC}               topic ref: types, billing, breaks, flags"
            echo -e "    ${WHITE}help full${NC}                  show everything on one screen"
            ;;
        quit|exit|q)
            echo -e "  ${BOLD}quit${NC} | ${BOLD}exit${NC} | ${BOLD}q${NC}              leave the timer"
            ;;
        *) return 1 ;;
    esac
    return 0
}

# Topic references.
